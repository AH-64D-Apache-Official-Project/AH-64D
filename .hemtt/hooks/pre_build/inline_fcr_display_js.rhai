// Inline CSS/JS into the FCR display HTMLs — the browser control cannot resolve relative paths inside a PBO

let fcr_ui_root = HEMTT_VFS
    .join("addons")
    .join("fza_ah64_fcr")
    .join("ui");

let shared_dir = fcr_ui_root.join("shared");
let displays = ["rmap", "tpm", "scope"];

// Assemble the icon atlas from shared/icons_b64/*.b64 (generated by tools/generate_fcr_icon_b64.ps1)
let icon_names = [];
for entry in shared_dir.join("icons_b64").list() {
    if entry.is_file() {
        let fname = entry.file_name();
        if fname.ends_with(".b64") {
            icon_names.push(fname.sub_string(0, fname.len() - 4));
        }
    }
}
icon_names.sort();

let icon_js = "// FCR icon atlas - assembled at build time by inline_fcr_display_js.rhai\n";
icon_js += "var _fcrIconData = {\n";
for i in 0..icon_names.len() {
    let name = icon_names[i];
    let b64 = shared_dir.join("icons_b64").join(name + ".b64").open_file().read();
    b64.trim();
    icon_js += "  \"" + name + "\": \"data:image/png;base64," + b64 + "\"";
    if i < icon_names.len() - 1 {
        icon_js += ",";
    }
    icon_js += "\n";
}
icon_js += "};";
print("FCR icon atlas: " + icon_names.len() + " icons");

for display_name in displays {
    let display_dir = fcr_ui_root.join(display_name);
    let html = display_dir.join(display_name + ".html").open_file().read();

    // Inline display-specific CSS
    let css_content = display_dir.join(display_name + ".css").open_file().read();
    let css_tag = "<link rel=\"stylesheet\" href=\"" + display_name + ".css\">";
    html.replace(css_tag, "<style>\n" + css_content + "\n</style>");

    // Inline the build-time icon atlas (replaces the stub fcr_icon_data.js tag)
    let icon_tag = "<script src=\"../shared/fcr_icon_data.js\"></script>";
    html.replace(icon_tag, "<script>\n" + icon_js + "\n</script>");

    // Inline the shared icon sprite layer
    let layer_content = shared_dir.join("fcr_icon_layer.js").open_file().read();
    let layer_tag = "<script src=\"../shared/fcr_icon_layer.js\"></script>";
    html.replace(layer_tag, "<script>\n" + layer_content + "\n</script>");

    // Inline shared FCR bridge JS
    let bridge_content = shared_dir.join("fcr_display_bridge.js").open_file().read();
    let bridge_tag = "<script src=\"../shared/fcr_display_bridge.js\"></script>";
    html.replace(bridge_tag, "<script>\n" + bridge_content + "\n</script>");

    // Inline display-specific JS
    let js_content = display_dir.join(display_name + ".js").open_file().read();
    let js_tag = "<script src=\"" + display_name + ".js\"></script>";
    html.replace(js_tag, "<script>\n" + js_content + "\n</script>");

    let out = display_dir.join(display_name + ".html").create_file();
    out.write(html);
}
